# College Complaint Management System Environment Variables

# Admin Portal Access Password (checked by backend)
ADMIN_PASSWORD="admin123"

# Database Configuration (Supabase)
# If provided, the backend will persist complaints directly to your Supabase PostgreSQL table
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Frontend CORS & API Configuration (for Render + Vercel deployment)
FRONTEND_URL=""
VITE_API_URL=""

# Razorpay Live Payment Gateway (Real-Time ₹50 Fee Collection)
# Get your Live Keys from https://dashboard.razorpay.com/app/keys
# Make sure your Razorpay Account KYC is activated and Bank Account linked for settlements
RAZORPAY_KEY_ID="rzp_live_your_actual_key_id"
RAZORPAY_KEY_SECRET="your_actual_razorpay_key_secret"
# Client-side Razorpay public key ID (optional, backend also provides it)
VITE_RAZORPAY_KEY_ID="rzp_live_your_actual_key_id"

# Server Port (Defaults to 3000 in AI Studio / Render dynamically sets PORT)
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls (injected by AI Studio)
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL=""

